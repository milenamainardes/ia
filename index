<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Real ou IA?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #12141c;
    --panel: #1b1f2c;
    --panel-edge: #262c3d;
    --amber: #e8a33d;
    --amber-dim: #a97a34;
    --text: #edeef3;
    --muted: #8d93a6;
    --good: #5cb894;
    --bad: #dd6b58;
    --film: #05060a;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: radial-gradient(ellipse at top, #1a1e2b 0%, var(--bg) 60%);
    color: var(--text);
    font-family: 'Work Sans', sans-serif;
    min-height: 100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding: 28px 16px;
  }
  .stage{
    width:100%;
    max-width: 460px;
  }
  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:600;
    margin:0;
  }
  .eyebrow{
    color: var(--amber);
    font-size: 13px;
    letter-spacing: 0.02em;
    margin: 0 0 6px 0;
  }
  /* ---- Intro screen ---- */
  .intro{
    text-align:center;
    padding: 8px 4px 4px;
  }
  .intro h1{
    font-size: 40px;
    line-height:1.05;
    letter-spacing: -0.01em;
  }
  .intro h1 em{
    font-style: italic;
    color: var(--amber);
  }
  .intro p{
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.55;
    max-width: 380px;
    margin: 16px auto 28px;
  }
  .filmband{
    display:flex;
    gap:6px;
    justify-content:center;
    margin: 0 0 30px;
  }
  .filmband div{
    width: 46px;
    height: 46px;
    border-radius: 6px;
    background-size:cover;
    background-position:center;
    filter: saturate(0.75);
    opacity:0.85;
    transform: rotate(var(--r,0deg));
  }
  button{
    font-family:'Work Sans', sans-serif;
    cursor:pointer;
    border:none;
  }
  .btn-primary{
    background: var(--amber);
    color: #201404;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 34px;
    border-radius: 30px;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .btn-primary:hover{ background:#f0b054; transform: translateY(-1px); }
  .btn-primary:active{ transform: translateY(0px) scale(0.98); }

  /* ---- Quiz screen ---- */
  .quiz{ display:none; }
  .quiz.active{ display:block; }
  .intro.hidden, .end.hidden{ display:none; }

  .progress{
    display:flex;
    gap:6px;
    justify-content:center;
    margin-bottom: 22px;
  }
  .progress .dot{
    width:7px; height:7px; border-radius:50%;
    background: var(--panel-edge);
    transition: background 0.2s;
  }
  .progress .dot.done-real{ background: var(--muted); }
  .progress .dot.done-correct{ background: var(--good); }
  .progress .dot.done-wrong{ background: var(--bad); }
  .progress .dot.current{ background: var(--amber); }

  .frame{
    background: var(--film);
    border-radius: 14px;
    padding: 10px 10px 16px;
    position: relative;
    box-shadow: 0 20px 40px -18px rgba(0,0,0,0.7);
  }
  .sprockets{
    display:flex;
    justify-content:space-between;
    padding: 0 4px 8px;
  }
  .sprockets span{
    width:7px; height:7px;
    background: #2b2f3c;
    border-radius:1.5px;
    display:block;
  }
  .photo-wrap{
    border-radius: 6px;
    overflow:hidden;
    aspect-ratio: 1 / 1;
    background:#0a0b10;
  }
  .photo-wrap img{
    width:100%; height:100%;
    object-fit:cover;
    display:block;
  }
  .caption{
    text-align:center;
    color: var(--muted);
    font-size: 12.5px;
    padding-top: 10px;
    letter-spacing: 0.01em;
  }

  .question{
    text-align:center;
    margin: 22px 0 16px;
    font-size: 19px;
    color: var(--text);
  }

  .choices{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 6px;
  }
  .choice{
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    color: var(--text);
    font-size: 15.5px;
    font-weight: 600;
    padding: 15px 8px;
    border-radius: 12px;
    transition: border-color 0.15s, transform 0.1s;
  }
  .choice:hover{ border-color: var(--amber-dim); transform: translateY(-1px); }
  .choice:active{ transform: translateY(0); }
  .choice:disabled{ opacity:0.55; }

  .result{
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    display:none;
  }
  .result.show{ display:block; animation: rise 0.25s ease; }
  @keyframes rise{ from{ opacity:0; transform: translateY(6px);} to{opacity:1; transform:translateY(0);} }
  .result .verdict{
    font-family:'Fraunces', serif;
    font-size: 18px;
    font-weight:600;
    margin-bottom: 6px;
  }
  .result.correct .verdict{ color: var(--good); }
  .result.wrong .verdict{ color: var(--bad); }
  .result p{
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.5;
    margin: 0;
  }

  .next-row{
    margin-top: 16px;
    text-align:center;
  }
  .btn-next{
    background: transparent;
    border: 1px solid var(--panel-edge);
    color: var(--text);
    font-size: 14.5px;
    font-weight:600;
    padding: 11px 26px;
    border-radius: 24px;
    display:none;
  }
  .btn-next.show{ display:inline-block; }
  .btn-next:hover{ border-color: var(--amber-dim); color: var(--amber); }

  /* ---- End screen ---- */
  .end{ display:none; text-align:center; }
  .end.active{ display:block; }
  .score-big{
    font-family:'Fraunces', serif;
    font-size: 64px;
    color: var(--amber);
    margin: 6px 0 0;
    line-height:1;
  }
  .score-label{
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 26px;
  }
  .end h2{
    font-size: 26px;
    margin-bottom: 4px;
  }
  .breakdown{
    text-align:left;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-radius: 12px;
    padding: 6px 16px;
    margin: 24px 0;
  }
  .breakdown .row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 11px 0;
    border-bottom: 1px solid var(--panel-edge);
    font-size: 14px;
  }
  .breakdown .row:last-child{ border-bottom:none; }
  .breakdown .tag{
    font-size:11px;
    font-weight:600;
    padding: 3px 9px;
    border-radius: 20px;
  }
  .tag.real{ background: rgba(140,148,170,0.18); color: var(--muted); }
  .tag.ia{ background: rgba(232,163,61,0.18); color: var(--amber); }
  .breakdown .mark{ font-weight:700; }
  .mark.ok{ color: var(--good); }
  .mark.no{ color: var(--bad); }

  footer{
    text-align:center;
    color: #565c70;
    font-size: 12px;
    margin-top: 28px;
    line-height:1.6;
  }
</style>
</head>
<body>
<div class="stage">

  <div class="intro" id="intro">
    <p class="eyebrow">um pequeno teste de percepção</p>
    <h1>Você distingue<br>um rosto <em>real</em><br>de um rosto de <em>IA</em>?</h1>
    <div class="filmband" id="filmband"></div>
    <p>12 retratos, um de cada vez. Para cada um, diga se acha que é a fotografia de uma pessoa real ou uma imagem gerada por inteligência artificial. Sempre que for IA, mostramos o que denuncia a imagem.</p>
    <button class="btn-primary" id="startBtn">Começar o teste</button>
  </div>

  <div class="quiz" id="quiz">
    <div class="progress" id="progress"></div>

    <div class="frame">
      <div class="sprockets">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="photo-wrap">
        <img id="photo" src="" alt="Retrato para avaliar">
      </div>
      <div class="caption" id="caption">foto 1 de 12</div>
    </div>

    <p class="question">Real ou gerada por IA?</p>

    <div class="choices">
      <button class="choice" id="btnReal">É real</button>
      <button class="choice" id="btnIa">É IA</button>
    </div>

    <div class="result" id="result">
      <div class="verdict" id="verdict"></div>
      <p id="explanation"></p>
    </div>

    <div class="next-row">
      <button class="btn-next" id="nextBtn">Próxima foto</button>
    </div>
  </div>

  <div class="end" id="end">
    <p class="eyebrow">resultado</p>
    <div class="score-big"><span id="scoreNum">0</span>/12</div>
    <p class="score-label" id="scoreMsg">acertos</p>
    <h2>Como você foi</h2>
    <div class="breakdown" id="breakdown"></div>
    <button class="btn-primary" id="restartBtn">Tentar de novo</button>
  </div>

  <footer>Imagens de rostos reais e de rostos sintéticos, usadas apenas para este exercício de percepção.</footer>
</div>

<script>
const ITEMS = [{"id": "real_0", "type": "real", "src": ""}, {"id": "real_1", "type": "real", "src": ""}, {"id": "real_2", "type": "real", "src": ""}, {"id": "real_3", "type": "real", "src": ""}, {"id": "real_4", "type": "real", "src": ""}, {"id": "real_5", "type": "real", "src": ""}, {"id": "ia_0", "type": "ia", "src": "", "reason": "Repare nos brincos: são diferentes entre si — de um lado há uma pérola pendurada, do outro apenas um pontinho de metal. Assimetria em acessórios (brincos, óculos, colares) é uma das marcas mais comuns de rostos gerados por IA."}, {"id": "ia_1", "type": "ia", "src": "", "reason": "O cabelo se dissolve no fundo sem uma linha de contorno definida, e a pele tem uma suavidade quase de porcelana, sem poros ou marcas reais de pele. IAs generativas tendem a 'alisar' demais a textura da pele."}, {"id": "ia_2", "type": "ia", "src": "", "reason": "Observe o tecido perto do colarinho, do lado esquerdo: a estampa vira uma mancha sem lógica, sem costura real. Tecidos e padrões pequenos costumam 'derreter' em imagens sintéticas."}, {"id": "ia_3", "type": "ia", "src": "", "reason": "A mão apoiada perto do ombro se funde com o cabelo, com dedos sem contornos definidos. Mãos e pontos de contato entre partes do corpo são historicamente o maior ponto fraco das IAs geradoras de rosto."}, {"id": "ia_4", "type": "ia", "src": "", "reason": "Os dentes têm formato irregular e um pouco 'derretido', e há um brinco visível em apenas uma das orelhas. São pequenas inconsistências que passam despercebidas para o gerador, mas o olho treinado percebe."}, {"id": "ia_5", "type": "ia", "src": "", "reason": "Os brincos são visivelmente diferentes entre as duas orelhas — de um lado uma gota pendurada, do outro um pontinho. Combinado com a simetria 'perfeita demais' do rosto, é um forte indício de imagem sintética."}];

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

let order = shuffle(ITEMS);
let current = 0;
let score = 0;
let answers = []; // {type, correct}
let answeredThis = false;

const introEl = document.getElementById('intro');
const quizEl = document.getElementById('quiz');
const endEl = document.getElementById('end');
const photoEl = document.getElementById('photo');
const captionEl = document.getElementById('caption');
const progressEl = document.getElementById('progress');
const resultEl = document.getElementById('result');
const verdictEl = document.getElementById('verdict');
const explanationEl = document.getElementById('explanation');
const nextBtn = document.getElementById('nextBtn');
const btnReal = document.getElementById('btnReal');
const btnIa = document.getElementById('btnIa');

// build filmstrip preview on intro
const filmband = document.getElementById('filmband');
shuffle(ITEMS).slice(0,5).forEach((it,idx)=>{
  const d = document.createElement('div');
  d.style.backgroundImage = `url(data:image/jpeg;base64,${it.src})`;
  d.style.setProperty('--r', `${(idx%2===0?-1:1)*(4+idx*2)}deg`);
  filmband.appendChild(d);
});

function buildProgress(){
  progressEl.innerHTML = '';
  order.forEach((_,i)=>{
    const dot = document.createElement('div');
    dot.className = 'dot';
    dot.id = 'dot-'+i;
    progressEl.appendChild(dot);
  });
}

function loadQuestion(){
  answeredThis = false;
  resultEl.classList.remove('show','correct','wrong');
  nextBtn.classList.remove('show');
  btnReal.disabled = false;
  btnIa.disabled = false;

  const item = order[current];
  photoEl.src = `data:image/jpeg;base64,${item.src}`;
  captionEl.textContent = `foto ${current+1} de ${order.length}`;

  document.querySelectorAll('.dot').forEach((d,i)=>{
    d.classList.remove('current','done-correct','done-wrong');
    if(i===current) d.classList.add('current');
  });
}

function answer(choice){
  if(answeredThis) return;
  answeredThis = true;
  btnReal.disabled = true;
  btnIa.disabled = true;

  const item = order[current];
  const isCorrect = choice === item.type;
  if(isCorrect) score++;
  answers.push({type:item.type, correct:isCorrect});

  const dot = document.getElementById('dot-'+current);
  dot.classList.remove('current');
  dot.classList.add(isCorrect ? 'done-correct' : 'done-wrong');

  resultEl.classList.add('show', isCorrect ? 'correct' : 'wrong');

  if(item.type === 'ia'){
    verdictEl.textContent = isCorrect ? 'Boa — era gerada por IA.' : 'Essa era gerada por IA.';
    explanationEl.textContent = item.reason;
  } else {
    verdictEl.textContent = isCorrect ? 'Boa — é uma foto real.' : 'Essa é uma foto real.';
    explanationEl.textContent = 'Uma fotografia genuína, sem sinais de geração sintética.';
  }

  nextBtn.classList.add('show');
}

btnReal.addEventListener('click', ()=>answer('real'));
btnIa.addEventListener('click', ()=>answer('ia'));

nextBtn.addEventListener('click', ()=>{
  current++;
  if(current >= order.length){
    showEnd();
  } else {
    loadQuestion();
  }
});

document.getElementById('startBtn').addEventListener('click', ()=>{
  introEl.classList.add('hidden');
  quizEl.classList.add('active');
  buildProgress();
  loadQuestion();
});

document.getElementById('restartBtn').addEventListener('click', ()=>{
  order = shuffle(ITEMS);
  current = 0;
  score = 0;
  answers = [];
  endEl.classList.remove('active');
  quizEl.classList.add('active');
  buildProgress();
  loadQuestion();
});

function showEnd(){
  quizEl.classList.remove('active');
  endEl.classList.add('active');
  document.getElementById('scoreNum').textContent = score;

  let msg;
  if(score === order.length) msg = 'perfeito — nada escapa ao seu olho';
  else if(score >= order.length*0.75) msg = 'muito bom olho crítico';
  else if(score >= order.length*0.5) msg = 'na média — IA está enganando bastante gente';
  else msg = 'as imagens sintéticas te pegaram desta vez';
  document.getElementById('scoreMsg').textContent = msg;

  const breakdown = document.getElementById('breakdown');
  breakdown.innerHTML = '';
  order.forEach((item,i)=>{
    const a = answers[i];
    const row = document.createElement('div');
    row.className = 'row';
    row.innerHTML = `
      <span class="tag ${item.type}">${item.type==='ia' ? 'IA' : 'real'}</span>
      <span>foto ${i+1}</span>
      <span class="mark ${a.correct?'ok':'no'}">${a.correct ? 'acertou' : 'errou'}</span>
    `;
    breakdown.appendChild(row);
  });
}
</script>
</body>
</html>
